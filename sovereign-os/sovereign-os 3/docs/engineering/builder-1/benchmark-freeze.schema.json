{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereign-os:devcontext:benchmark-freeze:v1",
  "title": "Builder 1 benchmark freeze manifest, version 1 (PROPOSED)",
  "description": "The detached manifest of BENCHMARK-PLAN.md section 5, step 8, written by `scripts/benchmark_freeze.py manifest`. It commits to the frozen input files and bundles by SHA-256; nothing commits to it except its own SHA-256, published at step 9. It never lives inside a bundle or a source commit. The assignment follows from inputs_digest, so nobody chooses it after seeing the inputs. `scripts/benchmark_freeze.py verify` checks every field against the files. PROPOSED: no manifest exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "tool",
    "agents",
    "tasks",
    "inputs_digest",
    "assignment"
  ],
  "properties": {
    "schema": {
      "const": "sovereign.devcontext.benchmark-freeze.v1"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "plan"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "plan": {
          "const": "docs/engineering/builder-1/BENCHMARK-PLAN.md"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "selection_version"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "selection_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "inputs_digest": {
      "$ref": "#/$defs/sha256"
    },
    "assignment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "agent",
          "first_arm"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "agent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "first_arm": {
            "enum": [
              "A",
              "B"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "set",
        "held_out",
        "target",
        "candidate",
        "must_be_absent",
        "inputs",
        "bundle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9-]{0,31}$"
        },
        "set": {
          "enum": [
            "calibration",
            "pilot",
            "main"
          ]
        },
        "held_out": {
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/sha"
        },
        "candidate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "must_be_absent": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/sha"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "sha256",
            "bytes",
            "refs"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "file",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "statement",
            "handoff_a",
            "gold_sheet",
            "hidden_tests",
            "evaluator_instructions"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
