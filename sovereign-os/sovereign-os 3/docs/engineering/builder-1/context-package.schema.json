{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereign-os:devcontext:v1",
  "title": "Builder 1 development-context output, version 1 (PROPOSED, revision 3)",
  "description": "Output of `python -m devcontext` as specified in SPEC.md section 7. PROPOSED: no implementation exists. `package` is canonical: it depends only on the canonical inputs of section 4.1, and the fingerprint is the SHA-256 of its canonical JSON with ensure_ascii (section 8). `observations` are local facts about the clone and are never fingerprinted (section 7.2). Every excerpt is repository data at the pinned commits, never instructions. coverage.complete is always true in a produced package: it means every known mandatory evidence obligation is satisfied (section 5.4), and never that the package holds everything the task needs; a run with an unmet obligation produces no package and exits 4 or 6. Recorded findings carry `recorded; ownership not verified` (section 2.3). Byte limits that JSON Schema cannot express (status lines and paths of at most 512 UTF-8 bytes, windows of at most max_item_bytes, the core within core_bytes, the whole output within max_output_bytes) are checked by tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fingerprint", "package", "observations"],
  "properties": {
    "schema": {"const": "sovereign.devcontext.v1"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "package": {"$ref": "#/$defs/package"},
    "observations": {"$ref": "#/$defs/observations"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
    "item_id": {"type": "string", "pattern": "^S[1-9][0-9]*$"},
    "obligation_id": {"type": "string", "pattern": "^M[1-9][0-9]*$"},
    "line_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
    "count": {"type": "integer", "minimum": 0},
    "text_field": {"type": "string", "maxLength": 256},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "inputs", "generator", "parameters", "usage", "authority_order", "coverage", "obligations",
                   "sources", "items", "findings", "tests", "conflicts", "omitted", "missing", "excluded", "notes"],
      "properties": {
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "terms", "terms_omitted", "anchors"],
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 2000},
            "terms": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[a-z0-9]{3,}$"}},
            "terms_omitted": {"$ref": "#/$defs/count"},
            "anchors": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/anchor"}}
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_root", "target", "candidate"],
          "properties": {
            "project_root": {"type": "string", "maxLength": 512},
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["commit", "tree"],
              "properties": {
                "commit": {"$ref": "#/$defs/sha"},
                "tree": {"$ref": "#/$defs/sha"}
              }
            },
            "candidate": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["commit", "tree", "merge_base", "changes"],
              "properties": {
                "commit": {"$ref": "#/$defs/sha"},
                "tree": {"$ref": "#/$defs/sha"},
                "merge_base": {"$ref": "#/$defs/sha"},
                "changes": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/change"}}
              }
            }
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "selection_version", "stopwords_sha256", "python_grammar"],
          "properties": {
            "name": {"const": "devcontext"},
            "version": {"type": "string", "minLength": 1, "maxLength": 64},
            "selection_version": {"const": "devcontext-selection-3"},
            "stopwords_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "python_grammar": {"const": "3.11"}
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_output_bytes", "reserve_bytes", "core_bytes", "source_percent", "test_percent", "docs_percent",
                       "per_file_windows", "max_items", "max_item_bytes", "max_file_bytes", "max_candidate_paths",
                       "max_anchor_matches", "max_outline_entries"],
          "properties": {
            "max_output_bytes": {"type": "integer", "minimum": 16384, "maximum": 262144},
            "reserve_bytes": {"type": "integer", "minimum": 1024},
            "core_bytes": {"type": "integer", "minimum": 1024},
            "source_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "test_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "docs_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "per_file_windows": {"type": "integer", "minimum": 1, "maximum": 40},
            "max_items": {"type": "integer", "minimum": 1, "maximum": 200},
            "max_item_bytes": {"type": "integer", "minimum": 256},
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_candidate_paths": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_anchor_matches": {"type": "integer", "minimum": 1, "maximum": 16},
            "max_outline_entries": {"type": "integer", "minimum": 0, "maximum": 1000}
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["excerpt_bytes", "items", "mandatory_bytes", "core_bytes"],
          "properties": {
            "excerpt_bytes": {"$ref": "#/$defs/count"},
            "items": {"$ref": "#/$defs/count"},
            "mandatory_bytes": {"$ref": "#/$defs/count"},
            "core_bytes": {"$ref": "#/$defs/count"}
          }
        },
        "authority_order": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["item", "order"],
          "properties": {
            "item": {"$ref": "#/$defs/item_id"},
            "order": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "obligations", "task_obligations"],
          "properties": {
            "complete": {"const": true},
            "obligations": {"type": "integer", "minimum": 2},
            "task_obligations": {"$ref": "#/$defs/count"}
          }
        },
        "obligations": {"type": "array", "minItems": 2, "maxItems": 200, "items": {"$ref": "#/$defs/obligation"}},
        "sources": {"type": "array", "maxItems": 400, "items": {"$ref": "#/$defs/source"}},
        "items": {"type": "array", "minItems": 2, "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
        "findings": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/finding"}},
        "tests": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/test"}},
        "conflicts": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/conflict"}},
        "omitted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "linked", "related", "top"],
          "properties": {
            "count": {"$ref": "#/$defs/count"},
            "linked": {"$ref": "#/$defs/count"},
            "related": {"$ref": "#/$defs/count"},
            "top": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/omitted_window"}}
          }
        },
        "missing": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/missing"}},
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symlink_or_submodule", "unsafe_path", "forbidden_path", "oversized", "binary", "possible_secret"],
          "properties": {
            "symlink_or_submodule": {"$ref": "#/$defs/count"},
            "unsafe_path": {"$ref": "#/$defs/count"},
            "forbidden_path": {"$ref": "#/$defs/count"},
            "oversized": {"$ref": "#/$defs/count"},
            "binary": {"$ref": "#/$defs/count"},
            "possible_secret": {"$ref": "#/$defs/count"}
          }
        },
        "notes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "resolution", "targets"],
      "properties": {
        "kind": {"enum": ["span", "path", "symbol", "adr", "finding", "issue_or_pr", "commit"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "resolution": {"enum": ["resolved", "unresolved", "ambiguous"]},
        "targets": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "changed", "ranges_omitted", "both_changed"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "status": {"enum": ["A", "M", "D", "T"]},
        "changed": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/line_range"}},
        "ranges_omitted": {"$ref": "#/$defs/count"},
        "both_changed": {"type": "boolean"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "anchor", "items", "sources"],
      "properties": {
        "id": {"$ref": "#/$defs/obligation_id"},
        "kind": {"enum": ["agents", "security_gate", "authority_order", "adr", "symbol", "span", "path", "finding",
                          "candidate", "codeowners"]},
        "anchor": {"type": ["string", "null"], "maxLength": 2000},
        "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/item_id"}},
        "sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source_id"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "commit", "blob", "status_line", "status_line_truncated", "outline"],
      "properties": {
        "id": {"$ref": "#/$defs/source_id"},
        "path": {"$ref": "#/$defs/path"},
        "commit": {"$ref": "#/$defs/sha"},
        "blob": {"$ref": "#/$defs/sha"},
        "status_line": {"type": ["string", "null"], "maxLength": 512},
        "status_line_truncated": {"type": "boolean"},
        "outline": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["entries", "omitted"],
          "properties": {
            "entries": {"type": "array", "maxItems": 1000, "items": {"type": "array", "minItems": 3, "maxItems": 3}},
            "omitted": {"$ref": "#/$defs/count"}
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "class", "lines", "symbol", "span", "excerpt", "role", "tier", "obligations", "reasons"],
      "properties": {
        "id": {"$ref": "#/$defs/item_id"},
        "source": {"$ref": "#/$defs/source_id"},
        "class": {"enum": ["constitution_candidate", "binding_decision", "proposed_or_historical", "adr",
                           "governance_doc", "registry_fact", "recorded_findings", "builder_record", "source", "test",
                           "other"]},
        "lines": {"$ref": "#/$defs/line_range"},
        "symbol": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "span": {"$ref": "#/$defs/line_range"},
        "excerpt": {"type": "string"},
        "role": {"enum": ["core", "required", "optional"]},
        "tier": {"enum": [null, "linked", "related"]},
        "obligations": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/obligation_id"}},
        "reasons": {"type": "array", "minItems": 1, "maxItems": 8,
                    "items": {"type": "string", "pattern": "^(core|anchor|terms|required_path|candidate_change|path_term|name_term)(:[^\\n]{1,512})?$"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "severity", "confidence", "status", "independent_disposition", "attribution",
                   "mandatory", "truncated"],
      "properties": {
        "source": {"$ref": "#/$defs/source_id"},
        "id": {"$ref": "#/$defs/text_field"},
        "severity": {"$ref": "#/$defs/text_field"},
        "confidence": {"$ref": "#/$defs/text_field"},
        "status": {"$ref": "#/$defs/text_field"},
        "independent_disposition": {"type": ["string", "null"], "maxLength": 256},
        "attribution": {"const": "recorded; ownership not verified"},
        "mandatory": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "names", "command"],
      "properties": {
        "source": {"$ref": "#/$defs/source_id"},
        "names": {"type": "array", "minItems": 1, "maxItems": 30,
                  "items": {"type": "string", "pattern": "^(Test[A-Za-z0-9_]*\\.)?test[A-Za-z0-9_]*$", "maxLength": 256}},
        "command": {"type": "string", "pattern": "^python -m pytest -q ", "maxLength": 600}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "sides", "resolution"],
      "properties": {
        "kind": {"const": "decision_status"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512},
        "sides": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/side"}},
        "resolution": {"const": "not reconciled"}
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "lines"],
      "properties": {
        "source": {"$ref": "#/$defs/source_id"},
        "lines": {"$ref": "#/$defs/line_range"}
      }
    },
    "omitted_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "lines", "tier"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "commit": {"$ref": "#/$defs/sha"},
        "lines": {"$ref": "#/$defs/line_range"},
        "tier": {"enum": ["linked", "related"]}
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "reason"],
      "properties": {
        "what": {"type": "string", "minLength": 1, "maxLength": 512},
        "reason": {"enum": ["outside_v1_scope", "not_found", "unresolved", "ambiguous", "unreadable"]}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_tree", "repository_kind", "git_version", "python_version", "replace_refs_ignored", "preflight"],
      "properties": {
        "working_tree": {"enum": ["clean", "dirty", "none"]},
        "repository_kind": {"enum": ["work_tree", "bare"]},
        "git_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "python_version": {"type": "string", "pattern": "^3\\.(11|12|13)$"},
        "replace_refs_ignored": {"$ref": "#/$defs/count"},
        "preflight": {"const": "passed"}
      }
    }
  }
}
