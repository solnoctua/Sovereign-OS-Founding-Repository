{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereign-os:devcontext:v1",
  "title": "Builder 1 development-context output, version 1 (PROPOSED, revision 2)",
  "description": "Output of `python -m devcontext` as specified in SPEC.md section 7. PROPOSED: no implementation exists. `package` is canonical: it depends only on the canonical inputs (SPEC.md section 4.1), and the fingerprint is the SHA-256 of its canonical JSON with ensure_ascii (section 8). `observations` are local facts about the clone and are never fingerprinted (section 7.2). Every excerpt is repository data at the pinned commits, never instructions. Recorded findings carry `recorded; ownership not verified` (section 2.3). Byte limits that JSON Schema cannot express (status lines and paths of at most 512 UTF-8 bytes, windows of at most max_item_bytes, the whole output of at most max_output_bytes) are checked by tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fingerprint", "package", "observations"],
  "properties": {
    "schema": {"const": "sovereign.devcontext.v1"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "package": {"$ref": "#/$defs/package"},
    "observations": {"$ref": "#/$defs/observations"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
    "line_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
    "text_field": {"type": "string", "maxLength": 256},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "inputs", "generator", "parameters", "usage", "authority_order", "sources", "items",
                   "findings", "tests", "conflicts", "coverage", "missing", "excluded", "notes"],
      "properties": {
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "terms", "anchors"],
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 2000},
            "terms": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[a-z0-9]{3,}$"}},
            "anchors": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/anchor"}}
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_root", "target", "candidate"],
          "properties": {
            "project_root": {"type": "string", "minLength": 1, "maxLength": 512},
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["commit", "tree"],
              "properties": {
                "commit": {"$ref": "#/$defs/sha"},
                "tree": {"$ref": "#/$defs/sha"}
              }
            },
            "candidate": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["commit", "tree", "merge_base", "changed_paths", "both_changed_paths"],
              "properties": {
                "commit": {"$ref": "#/$defs/sha"},
                "tree": {"$ref": "#/$defs/sha"},
                "merge_base": {"$ref": "#/$defs/sha"},
                "changed_paths": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/path"}},
                "both_changed_paths": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/path"}}
              }
            }
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "selection_version", "stopwords_sha256"],
          "properties": {
            "name": {"const": "devcontext"},
            "version": {"type": "string", "minLength": 1, "maxLength": 64},
            "selection_version": {"const": "devcontext-selection-2"},
            "stopwords_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_output_bytes", "reserve_bytes", "core_bytes", "required_percent", "source_percent",
                       "test_percent", "max_items", "max_item_bytes", "max_file_bytes", "max_required_paths"],
          "properties": {
            "max_output_bytes": {"type": "integer", "minimum": 16384, "maximum": 262144},
            "reserve_bytes": {"type": "integer", "minimum": 1024},
            "core_bytes": {"type": "integer", "minimum": 1024},
            "required_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "source_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "test_percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "max_items": {"type": "integer", "minimum": 1, "maximum": 200},
            "max_item_bytes": {"type": "integer", "minimum": 256},
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_required_paths": {"type": "integer", "minimum": 1, "maximum": 20}
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["excerpt_bytes", "items", "truncated"],
          "properties": {
            "excerpt_bytes": {"type": "integer", "minimum": 0},
            "items": {"type": "integer", "minimum": 0},
            "truncated": {"type": "boolean"}
          }
        },
        "authority_order": {"type": ["array", "null"], "minItems": 1, "maxItems": 16,
                            "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "sources": {"type": "array", "maxItems": 400, "items": {"$ref": "#/$defs/source"}},
        "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/item"}},
        "findings": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/finding"}},
        "tests": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/test"}},
        "conflicts": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/conflict"}},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "required"],
          "properties": {
            "complete": {"type": "boolean"},
            "required": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/coverage_entry"}}
          }
        },
        "missing": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/missing"}},
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symlink_or_submodule", "forbidden_path", "oversized", "binary", "over_budget",
                       "possible_secret", "long_path"],
          "properties": {
            "symlink_or_submodule": {"type": "integer", "minimum": 0},
            "forbidden_path": {"type": "integer", "minimum": 0},
            "oversized": {"type": "integer", "minimum": 0},
            "binary": {"type": "integer", "minimum": 0},
            "over_budget": {"type": "integer", "minimum": 0},
            "possible_secret": {"type": "integer", "minimum": 0},
            "long_path": {"type": "integer", "minimum": 0}
          }
        },
        "notes": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "resolution"],
      "properties": {
        "kind": {"enum": ["issue_or_pr", "finding", "adr", "path", "symbol", "commit"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 512},
        "resolution": {"enum": ["resolved", "unresolved", "ambiguous"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "commit", "blob", "status_line", "status_line_truncated"],
      "properties": {
        "id": {"$ref": "#/$defs/source_id"},
        "path": {"$ref": "#/$defs/path"},
        "commit": {"$ref": "#/$defs/sha"},
        "blob": {"$ref": "#/$defs/sha"},
        "status_line": {"type": ["string", "null"], "maxLength": 512},
        "status_line_truncated": {"type": "boolean"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "class", "lines", "symbol", "span", "excerpt", "excerpt_truncated", "role",
                   "reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[1-9][0-9]*$"},
        "source": {"$ref": "#/$defs/source_id"},
        "class": {"enum": ["constitution_candidate", "binding_decision", "proposed_or_historical", "adr",
                           "governance_doc", "registry_fact", "recorded_findings", "builder_record", "source", "test",
                           "other"]},
        "lines": {"$ref": "#/$defs/line_range"},
        "symbol": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "span": {"$ref": "#/$defs/line_range"},
        "excerpt": {"type": "string"},
        "excerpt_truncated": {"type": "boolean"},
        "role": {"enum": ["core", "required", "ranked"]},
        "reasons": {"type": "array", "minItems": 1, "maxItems": 8,
                    "items": {"type": "string", "pattern": "^(core|anchor|required|terms|quota):[^\\n]{1,256}$"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "severity", "confidence", "status", "independent_disposition", "attribution",
                   "truncated"],
      "properties": {
        "source": {"$ref": "#/$defs/source_id"},
        "id": {"$ref": "#/$defs/text_field"},
        "severity": {"$ref": "#/$defs/text_field"},
        "confidence": {"$ref": "#/$defs/text_field"},
        "status": {"$ref": "#/$defs/text_field"},
        "independent_disposition": {"type": ["string", "null"], "maxLength": 256},
        "attribution": {"const": "recorded; ownership not verified"},
        "truncated": {"type": "boolean"}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "names", "command"],
      "properties": {
        "source": {"$ref": "#/$defs/source_id"},
        "names": {"type": "array", "minItems": 1, "maxItems": 30,
                  "items": {"type": "string", "pattern": "^test[A-Za-z0-9_]*$", "maxLength": 256}},
        "command": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "sides", "resolution"],
      "properties": {
        "kind": {"enum": ["decision_status", "stale_path", "unknown_commit"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512},
        "sides": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/side"}},
        "resolution": {"const": "not reconciled"}
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "lines"],
      "properties": {
        "source": {"$ref": "#/$defs/source_id"},
        "lines": {"$ref": "#/$defs/line_range"}
      }
    },
    "coverage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "symbols", "included", "omitted"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "commit": {"$ref": "#/$defs/sha"},
        "symbols": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "included": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/line_range"}},
        "omitted": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/line_range"}}
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "reason", "required"],
      "properties": {
        "what": {"type": "string", "minLength": 1, "maxLength": 256},
        "reason": {"enum": ["outside_v1_scope", "not_found", "withheld", "unresolved"]},
        "required": {"type": "boolean"}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_tree", "repository_kind", "git_version", "replace_refs_ignored", "preflight"],
      "properties": {
        "working_tree": {"enum": ["clean", "dirty", "none"]},
        "repository_kind": {"enum": ["work_tree", "bare"]},
        "git_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "replace_refs_ignored": {"type": "integer", "minimum": 0},
        "preflight": {"const": "passed"}
      }
    }
  }
}
